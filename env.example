## Copy to `.env.local` (do not commit `.env.local`)
#
# OpenAI (used to generate a consistent avatar prompt from leader JSON)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano-2025-08-07
#
# OpenAI model that supports Structured Outputs (json_schema). Used for leader generation.
OPENAI_STRUCTURED_MODEL=gpt-5-nano-2025-08-07
#
# OpenAI model for chat (all operations now use gpt-5-nano-2025-08-07)
OPENAI_CHAT_MODEL=gpt-5-nano-2025-08-07
#
# Replicate (used to generate the actual image via google/imagen-3)
REPLICATE_API_TOKEN=
#
# Also used for character trailers via kwaivgi/kling-v2.6

# Supabase (DB + optional Storage)
# Use SERVICE_ROLE_KEY only on the server (Route Handlers). Never expose it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


